    "components": {
        "schemas": {
            "PanelPosition": {
                "type": "string",
                "enum": [
                    "top-left",
                    "top-right",
                    "top-center",
                    "bottom-left",
                    "bottom-center",
                    "bottom-right"
                ]
            },
            "Themes": {
                "type": "string",
                "enum": [
                    "light",
                    "dark",
                    "cupcake",
                    "bumblebee",
                    "emerald",
                    "corporate",
                    "synthwave",
                    "retro",
                    "cyberpunk",
                    "valentine",
                    "halloween",
                    "garden",
                    "forest",
                    "aqua",
                    "lofi",
                    "pastel",
                    "fantasy",
                    "wireframe",
                    "black",
                    "luxury",
                    "dracula",
                    "cmyk",
                    "autumn",
                    "business",
                    "acid",
                    "lemonade",
                    "night",
                    "coffee",
                    "winter",
                    "dim",
                    "nord",
                    "sunset"
                ]
            },
            "VisibilityType": {
                "type": "string",
                "enum": [
                    "private",
                    "public"
                ],
                "deprecated": true
            },
            "RegisterRequest": {
                "required": [
                    "name"
                ],
                "allOf": [
                    {
                        "properties": {
                            "name": {
                                "type": "string"
                            }
                        },
                        "type": "object"
                    },
                    {
                        "$ref": "#/components/schemas/LoginRequest"
                    }
                ]
            },
            "ErrorObject": {
                "required": [
                    "message",
                    "errors"
                ],
                "properties": {
                    "message": {
                        "type": "string",
                        "example": "Validation failed."
                    },
                    "errors": {
                        "type": "object",
                        "additionalProperties": {
                            "type": "array",
                            "items": {
                                "type": "string",
                                "example": "Field is required"
                            }
                        }
                    }
                },
                "type": "object"
            },
            "LangObject": {
                "type": "object",
                "additionalProperties": {
                    "oneOf": [
                        {
                            "type": "string"
                        },
                        {
                            "$ref": "#/components/schemas/LangObject"
                        }
                    ]
                }
            },
            "LoginRequest": {
                "required": [
                    "email",
                    "password",
                    "remember"
                ],
                "properties": {
                    "email": {
                        "type": "string",
                        "format": "email"
                    },
                    "password": {
                        "type": "string",
                        "format": "password",
                        "minLength": 8
                    },
                    "remember": {
                        "type": "boolean",
                        "default": true
                    }
                },
                "type": "object"
            },
            "StoreBlockRequest": {
                "required": [
                    "x",
                    "y",
                    "width",
                    "height",
                    "path",
                    "content"
                ],
                "properties": {
                    "x": {
                        "type": "integer"
                    },
                    "y": {
                        "type": "integer"
                    },
                    "width": {
                        "type": "integer"
                    },
                    "height": {
                        "type": "integer"
                    },
                    "path": {
                        "type": "string"
                    },
                    "content": {
                        "type": [
                            "string",
                            "null"
                        ]
                    }
                },
                "type": "object"
            },
            "StoreProjectRequest": {
                "required": [
                    "nameOrUrl"
                ],
                "properties": {
                    "nameOrUrl": {
                        "type": "string"
                    }
                },
                "type": "object"
            },
            "UpdateBlockRequest": {
                "required": [
                    "x",
                    "y",
                    "width",
                    "height",
                    "path",
                    "content"
                ],
                "properties": {
                    "x": {
                        "type": "integer"
                    },
                    "y": {
                        "type": "integer"
                    },
                    "width": {
                        "type": "integer"
                    },
                    "height": {
                        "type": "integer"
                    },
                    "path": {
                        "type": "string"
                    },
                    "content": {
                        "type": [
                            "string",
                            "null"
                        ]
                    }
                },
                "type": "object"
            },
            "UpdateProjectRequest": {
                "required": [
                    "name",
                    "description",
                    "x",
                    "y",
                    "zoom"
                ],
                "properties": {
                    "name": {
                        "type": "string"
                    },
                    "description": {
                        "type": [
                            "string",
                            "null"
                        ]
